# --- AI ---------------------------------------------------------------
# mock   = offline, uses ground-truth files from datagen (no Google account needed)
# gemini = real Gemini on Vertex AI
AI_MODE=mock
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
MODEL_EXTRACT=gemini-3.8-flash
MODEL_REASON=gemini-3.1-pro-preview
MODEL_REASON_FALLBACK=gemini-3.8-flash

# --- storage ----------------------------------------------------------
# memory/local for development; firestore/gcs on Cloud Run
STORE_BACKEND=memory
FILE_BACKEND=local
GCS_BUCKET=your-project-id-firstpass-docs

ALLOW_ORIGINS=http://localhost:5173
